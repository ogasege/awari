{
  "name": "awari",
  "version": "0.1.0",
  "private": true,
  "description": "Awari: a free, offline-first encyclopedia for curious students.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && tsx scripts/build-sw.ts",
    "preview": "vite preview --host 127.0.0.1",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:props": "vitest run property",
    "packs": "tsx scripts/packs/build.ts && tsx scripts/quizzes/build.ts",
    "credits": "tsx scripts/check-credits.ts",
    "rules": "tsx scripts/check-rules.ts",
    "bundle": "tsx scripts/check-bundle.ts",
    "log": "tsx scripts/kiro-log.ts",
    "check": "npm run lint && npm run typecheck && npm test && npm run credits && npm run rules && npm run build && npm run bundle",
    "offline-check": "tsx scripts/offline-check.ts",
    "submission-check": "tsx scripts/submission-check.ts",
    "stats": "tsx scripts/stats.ts && tsx scripts/fill-numbers.ts"
  },
  "dependencies": {
    "@fontsource/bricolage-grotesque": "^5.3.0",
    "@fontsource/covered-by-your-grace": "^5.3.0",
    "@fontsource/figtree": "^5.3.0",
    "d3-geo": "^3.1.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.9",
    "@types/d3-geo": "^3.1.1",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.8",
    "fast-check": "^4.10.2",
    "globals": "^17.14.0",
    "jsdom": "^29.1.1",
    "playwright": "^1.65.0",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^4.1.12"
  }
}
