{
  "enabled": true,
  "name": "Hard-rule guard before the agent finishes",
  "description": "When the agent finishes a turn, check the hackathon hard rules: .kiro present and not ignored, MIT LICENSE, and no banned product name anywhere in the repo.",
  "version": "1",
  "when": {
    "type": "agentStop"
  },
  "then": {
    "type": "runCommand",
    "command": "npm run rules"
  }
}
